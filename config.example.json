{
  "device_address": "SEU:ENDERECO:BLE:AQUI",
  "device_name": "Wy Glass",
  "firmware": "LNJ-W03",
  "notify_char_uuid": "0000ff03-0000-1000-8000-00805f9b34fb",
  "actions_enabled": true,
  "battery_low_threshold": 20,
  "credentials": {
    "groq_api_key": "SUA_CHAVE_GROQ_AQUI",
    "tavily_api_key": "SUA_CHAVE_TAVILY_AQUI",
    "google_api_key": "SUA_CHAVE_GEMINI_AQUI"
  },
  "passive_listening": {
    "enabled": true,
    "wake_word": {
      "enabled": true,
      "model": "hey_jarvis",
      "threshold": 0.5,
      "gesture": "wake_word_command"
    },
    "clap_detection": {
      "enabled": false,
      "threshold_rms": 4000,
      "max_duration_ms": 120,
      "pair_window_ms": [
        150,
        700
      ],
      "gesture": "button1_single"
    }
  },
  "gestures": {
    "button1_single": {
      "label": "Botão 1 · Jarvis (headless, unificado)",
      "action": "open_jarvis_agent",
      "params": {
        "session_id": "wyglass",
        "tts_model": "pt_BR-faber-medium.onnx",
        "max_duration_seconds": 15,
        "silence_duration_seconds": 1,
        "silence_threshold": 400
      },
      "reliability": "high"
    },
    "button2_single": {
      "label": "Botão 2 · Encerrar conversa",
      "action": "stop_conversation",
      "params": {
        "farewell_text": "Até mais!",
        "tts_model": "pt_BR-faber-medium.onnx"
      },
      "reliability": "high"
    },
    "button1_double": {
      "label": "Botão 1 duplo · Modo LIVE (voz realtime, liga/desliga)",
      "action": "live_agent",
      "params": {},
      "reliability": "high"
    },
    "button2_double": {
      "label": "Botão 2 duplo · Abrir dashboard",
      "action": "open_dashboard",
      "params": {},
      "reliability": "high"
    },
    "button1_triple": {
      "label": "Botão 1 triplo · Tradutor (PT↔EN, bidirecional)",
      "action": "translator_agent",
      "params": {
        "pt_tts_model": "pt_BR-faber-medium.onnx",
        "en_tts_model": "en_US-lessac-medium.onnx",
        "max_duration_seconds": 15,
        "silence_duration_seconds": 1,
        "silence_threshold": 400
      },
      "reliability": "medium"
    },
    "wake_word_command": {
      "label": "Hey Jarvis (wake word) · Jarvis com verificação de voz",
      "action": "open_jarvis_agent",
      "params": {
        "session_id": "wyglass",
        "tts_model": "pt_BR-faber-medium.onnx",
        "max_duration_seconds": 15,
        "silence_duration_seconds": 1,
        "silence_threshold": 400,
        "require_speaker_match": true,
        "speaker_match_threshold": 0.75
      },
      "reliability": "medium"
    }
  },
  "live": {
    "model": "gemini-3.1-flash-live-preview",
    "voice": "Charon",
    "barge_in_rms": 2500,
    "silence_ms": 600,
    "pause_phrases": [
      "espera um minutinho",
      "espera um pouco",
      "espera um minuto",
      "só um minuto",
      "só um minutinho",
      "um momento",
      "só um momento",
      "pausa",
      "aguarda",
      "segura aí",
      "já volto",
      "me dá um minuto"
    ],
    "wake_phrases": [
      "e aí óculos",
      "hey jarvis",
      "pode continuar",
      "sankofa"
    ],
    "wake_aliases": {
      "hey jarvis": [
        "em chaves",
        "ei jarvis"
      ]
    },
    "pause_timeout_min": 30,
    "confirm_actions": true
  },
  "nine_router": {
    "enabled": false,
    "base_url": "http://localhost:20128/v1",
    "api_key": "",
    "model": "auto"
  },
  "gestures_disabled": {
    "button1_double": {
      "label": "Botão 1 duplo · Jarvis (Groq, conversa contínua)",
      "action": "open_jarvis_agent",
      "params": {
        "session_id": "wyglass",
        "user_name": "SEU_NOME_AQUI",
        "user_role": "sua atividade/papel",
        "tts_model": "pt_BR-faber-medium.onnx",
        "max_duration_seconds": 15,
        "silence_duration_seconds": 1,
        "silence_threshold": 400,
        "conversation_mode": true
      },
      "reliability": "high"
    }
  },
  "claude_code": {
    "enabled": true,
    "exe": "",
    "cwd": "",
    "allowed_tools": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch"
    ],
    "permission_mode": "default",
    "model": "",
    "timeout_seconds": 180
  },
  "user_profile": {
    "user_name": "SEU_NOME_AQUI",
    "user_role": "sua atividade/papel",
    "user_context": "contexto livre: stack, projetos, interesses, como prefere as respostas"
  },
  "mcp_servers": [
    {
      "name": "current-brain",
      "description": "Segundo cérebro do Brain Office: contexto, metas, trilhas, conteúdo, repos e criadores",
      "enabled": true,
      "command": "node",
      "args": [
        "--no-warnings",
        "--import",
        "file:///{office}/node_modules/tsx/dist/loader.mjs",
        "{office}/services/brain/apps/mcp/src/index.ts"
      ],
      "env": {
        "MCB_DB_PATH": "{office}/data/brain/brain.db",
        "MCB_AGENT": "wy-glass"
      },
      "connect_timeout": 60,
      "tools": [
        "get_context",
        "search",
        "list_content",
        "get_content",
        "add_link",
        "list_goals",
        "create_goal",
        "update_goal",
        "list_trending_repos",
        "list_creator_posts",
        "list_milestones",
        "suggest_project",
        "record_feedback"
      ],
      "cwd": "{office}/services/brain"
    },
    {
      "name": "planner-life",
      "description": "Planner Life do Brain Office: coleções, registros e automações (escrita precisa do Planner Core em :4000, que o Brain Office sobe)",
      "enabled": true,
      "command": "node",
      "args": [
        "{office}/services/planner/packages/mcp/dist/index.js"
      ],
      "env": {
        "PLANNER_CORE_URL": "http://localhost:4000",
        "PLANNER_AGENT_URL": "http://localhost:4100"
      },
      "tools": [
        "list_collections",
        "list_records",
        "save_record",
        "list_automations",
        "automation_runs"
      ]
    }
  ],
  "brain_office": {
    "repo_dir": "",
    "planner_db": "{office}/data/planner/planner.db",
    "brain_db": "{office}/data/brain/brain.db"
  }
}