# Planner Core
CORE_PORT=4000
DB_PATH=./data/planner.db

# Agent runtime -- Personal Agent
AGENT_PORT=4100
CORE_API_URL=http://localhost:4000
# Pasta default onde a ferramenta run_claude_code executa `claude -p` quando
# o pedido nao especifica uma pasta. Requer o Claude Code CLI instalado
# (`npm install -g @anthropic-ai/claude-code`) e autenticado nessa maquina.
CLAUDE_CODE_CWD=

# Qual provider de IA usar: groq | gemini | anthropic
# Deixe em branco para autodetectar pela primeira chave preenchida abaixo
# (ordem: Groq -> Gemini -> Anthropic). Groq e Gemini tem free tier.
AGENT_PROVIDER=

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic / Claude (pago) - opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# P2P node
P2P_TCP_PORT=4400
P2P_NODE_NAME=pc-principal
# Porta HTTP local do p2p-node (so 127.0.0.1) -- o Planner Core chama essa
# porta pra publicar eventos de verdade na rede P2P via gossipsub.
P2P_HTTP_PORT=4401
# Usado pelo Planner Core para achar o bridge HTTP do p2p-node local.
P2P_NODE_HTTP_URL=http://127.0.0.1:4401

# Voice (Piper, TTS local em portugues) - veja packages/voice/README.md
VOICE_PORT=4200
# Caminhos default (Windows) ja apontam para packages/voice/vendor -- so
# mude se voce baixou o binario/modelo em outro lugar (ex: Raspberry Pi).
PIPER_BIN=
PIPER_MODEL=

# Obsidian (opcional) -- pasta do seu vault de verdade (Obsidian e so
# arquivos .md numa pasta, entao o Planner le/escreve direto nela). Se
# deixar em branco, usa uma pasta local (data/vault) que funciona igual,
# so que sem o app Obsidian.
OBSIDIAN_VAULT_PATH=

# Rotinas proativas (editavel pela aba Configuracoes do dashboard) -- resumo
# da manha, aviso antes de compromisso e tarefa do Google Tasks
# atrasada/vencendo hoje. NOTIFICATION_SOUND_ENABLED liga/desliga o som no
# toast do navegador (o app desktop ja usa o som padrao do sistema).
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_HOUR=8
EVENT_REMINDER_ENABLED=true
EVENT_REMINDER_MINUTES=15
GOOGLE_TASKS_REMINDER_ENABLED=true
NOTIFICATION_SOUND_ENABLED=true

# Google OAuth (Gmail + Calendar + Tasks) - crie um cliente OAuth em
# https://console.cloud.google.com/apis/credentials (tipo "Desktop app" ou
# "Web application") e ative as APIs Gmail, Calendar e Tasks no mesmo
# projeto. Escopos usados: gmail.readonly, calendar (leitura e escrita),
# tasks, userinfo.email. Da pra conectar mais de uma conta Google (cada /auth
# mostra o seletor de conta).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
WEB_APP_URL=http://localhost:4300

# Dashboard (Next.js) -- porta do servidor e URLs publicas que o navegador
# usa pra chamar cada servico. So precisam mudar se voce rodar algo fora
# do localhost (ex: acessando o dashboard de outro dispositivo na rede).
WEB_PORT=4300
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000
NEXT_PUBLIC_AGENT_API_URL=http://localhost:4100
NEXT_PUBLIC_VOICE_API_URL=http://localhost:4200
NEXT_PUBLIC_P2P_HTTP_URL=http://localhost:4401
